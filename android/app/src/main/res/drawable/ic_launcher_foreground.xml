<?xml version="1.0" encoding="utf-8"?>
<!-- آیکون سه‌بعدی: برگ سفید نوبت‌سبز با گرادیان، جیغ روشن و سایه -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- سایه‌ی محو زیر برگ (عمق سه‌بعدی) -->
    <path
        android:fillColor="#33000000"
        android:pathData="M54 32 C 36 44, 32 66, 54 84 C 76 66, 72 44, 54 32 Z" />

    <!-- برگ اصلی با گرادیان عمودی (سفید → آبی روشن) -->
    <path android:pathData="M54 28 C 36 40, 32 62, 54 80 C 76 62, 72 40, 54 28 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="28"
                android:endX="54"
                android:endY="80"
                android:startColor="#FFFFFF"
                android:endColor="#BFD9FF" />
        </aapt:attr>
    </path>

    <!-- رگبرگ اصلی -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#661E6FE0"
        android:strokeWidth="2.4"
        android:strokeLineCap="round"
        android:pathData="M54 34 L54 74" />

    <!-- رگبرگ‌های جانبی -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#4D1E6FE0"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:pathData="M54 48 L45 41 M54 48 L63 41 M54 60 L46 52 M54 60 L62 52" />
</vector>
